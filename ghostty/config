keybind = shift+enter=text:\n
theme = dark:0x96f,light:Bluloco Light
font-family = "TX-02 Retina"
font-family = "IBM Plex Mono"
font-size = 10
font-style = Regular
font-feature = -calt
font-feature = -liga
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor
quit-after-last-window-closed = true
quit-after-last-window-closed-delay = 5m

# Machine-local overrides, loaded last so they win. bootstrap.sh links the
# macOS-specific overrides here on Darwin; on other machines this file simply
# does not exist and the ? prefix makes that a no-op.
config-file = ?config.local
