  "css": "@keyframes t3-working-spin { to { transform: rotate(360deg); } }\n[data-thread-item] svg.lucide-circle-dashed {\n  animation: t3-working-spin 1s linear infinite !important;\n  transform-origin: center;\n  transform-box: fill-box;\n}\n\n/* Flat: zera sombras de elevacao (shadow-xs, inset highlight, linhas do ::before). O anel de foco usa --tw-ring-shadow e fica intacto. */\n*, *::before, *::after {\n  --tw-shadow: 0 0 #0000 !important;\n  --tw-inset-shadow: 0 0 #0000 !important;\n}\n[data-slot]::before,\n[data-slot]::after {\n  box-shadow: none !important;\n}"
