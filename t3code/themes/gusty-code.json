  "css": "@keyframes t3-working-spin { to { transform: rotate(360deg); } }\n[data-thread-item] svg.lucide-circle-dashed {\n  animation: t3-working-spin 1s linear infinite !important;\n  transform-origin: center;\n  transform-box: fill-box;\n}\n\n/* Flat: zera sombras de elevacao (shadow-xs, inset highlight, linhas do ::before). O anel de foco usa --tw-ring-shadow e fica intacto. */\n*, *::before, *::after {\n  --tw-shadow: 0 0 #0000 !important;\n  --tw-inset-shadow: 0 0 #0000 !important;\n}\n[data-slot]::before,\n[data-slot]::after {\n  box-shadow: none !important;\n}\n\n/* Swap the model picker and file attachment in the composer footer. */\n@supports (anchor-name: --gusty-attach-slot) and (inset-inline-start: anchor(start)) {\n  [data-chat-composer-footer]:has(> div > button[aria-label=\"Attach files\"]):has([data-chat-composer-footer-controls] > [data-chat-provider-model-picker]) {\n    --gusty-attach-size: calc(var(--spacing, 0.25rem) * 8);\n    position: relative;\n\n    @media (min-width: 40rem) {\n      --gusty-attach-size: calc(var(--spacing, 0.25rem) * 7);\n    }\n    anchor-scope: --gusty-attach-slot;\n\n    & > div:has(> button[aria-label=\"Attach files\"]) {\n      position: absolute;\n      position-anchor: --gusty-attach-slot;\n      inset-inline-start: anchor(start);\n      inset-block-start: anchor(center);\n      translate: 0 -50%;\n      margin-inline-end: 0;\n      z-index: 1;\n    }\n\n    & [data-chat-composer-footer-controls] {\n      justify-content: flex-start;\n\n      &::before {\n        content: \"\";\n        anchor-name: --gusty-attach-slot;\n        flex: 0 0 var(--gusty-attach-size);\n        block-size: 1px;\n        order: 1;\n        margin-inline-start: auto;\n      }\n\n      & > :not([data-chat-provider-model-picker]) {\n        order: 2;\n      }\n    }\n  }\n}\n"
